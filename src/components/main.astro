---
import Link from "./icons/Link.astro";

const postModules = import.meta.glob<{
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    externalUrl?: string;
  };
}>("../pages/writing/*.mdx", { eager: true });

const recentPosts = Object.entries(postModules)
  .map(([path, post]) => ({
    ...post.frontmatter,
    url:
      post.frontmatter.externalUrl ||
      path.replace(".mdx", "").replace("../pages", ""),
  }))
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf())
  .slice(0, 3);

const projects = [
  {
    label: "ProveKit",
    href: "github.com/worldfnd/provekit",
    role: "Core contributor @ World",
    description:
      "Client-side zero-knowledge proving for World ID. Work spans witness solving, challenge soundness, recursive verification, and prover performance.",
  },
  {
    label: "WHIR",
    href: "github.com/WizardOfMenlo/whir",
    role: "Contributor",
    description:
      "Reed–Solomon proximity testing with super-fast verification. Added batch prove/verify and recursive verification support.",
  },
  {
    label: "zk-regex v2",
    href: "github.com/zkemail/zk-regex",
    role: "Author @ ZkEmail",
    description:
      "Regex-to-circuit compiler (Circom/Noir) with off-circuit NFA traversal and in-circuit proof.",
  },
  {
    label: "Jolt",
    href: "github.com/a16z/jolt",
    role: "Contributor @ a16z crypto",
    description:
      "RISC-V zkVM. Wrote the migration spec for its Fiat-Shamir transcript to spongefish.",
  },
];

const publication = {
  title:
    "Zero-Knowledge Proofs of Generalized Regular Expression Matching for Anonymized Email Verification",
  venue: "PoPETs 2026(4) · pp. 740–771",
  href: "/publications",
};

const socials = [
  {
    label: "shreyas_londhe@outlook.com",
    href: "mailto:shreyas_londhe@outlook.com",
  },
  {
    label: "X",
    href: "https://x.com/shreyas_twts",
  },
  {
    label: "GitHub",
    href: "https://github.com/shreyas-londhe",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/shreyaslondhe",
  },
  {
    label: "Resume",
    href: "/shreyas_resume.pdf",
  },
];
---

<main>
  <section class="mt-10">
    <h2
      class="animate-intro mb-3 font-medium opacity-0 [animation-delay:0.3s]"
    >
      <span class="text-blue-500">—</span> Featured Work
    </h2>
    <ul
      class="animate-intro relative flex flex-col gap-y-4 opacity-0 [animation-delay:0.35s]"
    >
      {
        projects.map((project) => (
          <li class="transition-transform hover:translate-x-0.5">
            <a
              href={`https://${project.href}`}
              rel="noreferrer"
              target="_blank"
              class="flex w-fit items-center"
            >
              {project.label}
              <Link />
            </a>
            <p class="mt-0.5 text-sm text-neutral-500 dark:text-neutral-400">
              {project.role}
            </p>
            <p class="mt-1 leading-snug font-light text-neutral-500 dark:text-neutral-400">
              {project.description}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="animate-intro mt-12 opacity-0 [animation-delay:0.4s]">
    <h2 class="mb-3 font-medium">
      <span class="text-blue-500">—</span> Publications
    </h2>
    <div class="transition-transform hover:translate-x-0.5">
      <a href={publication.href} class="block w-fit leading-snug">
        {publication.title}
      </a>
      <p class="mt-1 font-mono text-xs text-neutral-500 dark:text-neutral-400">
        {publication.venue}
      </p>
    </div>
  </section>

  <section class="animate-intro mt-12 opacity-0 [animation-delay:0.45s]">
    <h2 class="mb-3 flex items-baseline justify-between font-medium">
      <span><span class="text-blue-500">—</span> Recent Writing</span>
      <a
        href="/writing"
        class="exclude text-sm font-normal text-neutral-500 hover:text-blue-500 dark:text-neutral-400"
        >All writing →</a
      >
    </h2>
    <ul class="flex flex-col gap-y-4">
      {
        recentPosts.map((post) => (
          <li class="transition-transform hover:translate-x-0.5">
            <a href={post.url} class="flex w-fit items-baseline gap-x-2">
              <span class="leading-snug">{post.title}</span>
            </a>
            <p class="mt-0.5 font-mono text-xs text-neutral-500 dark:text-neutral-400">
              {new Date(post.pubDate).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="animate-intro mt-12 opacity-0 [animation-delay:0.5s]">
    <h2 class="mb-3 font-medium"><span class="text-blue-500">—</span> Connect</h2>
    <div class="flex flex-row flex-wrap items-center gap-x-1 gap-y-2">
      {
        socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noreferrer"
            class="exclude flex items-center rounded-full bg-neutral-200 px-3 py-1 text-sm transition-all select-none hover:scale-105 hover:bg-blue-50 dark:bg-neutral-800 dark:hover:bg-blue-950"
          >
            {social.label}
            <Link />
          </a>
        ))
      }
    </div>
  </section>
</main>
